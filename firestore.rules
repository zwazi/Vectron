rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /accounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'requestedAuthorName', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.requestedAuthorName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);

      allow update, delete: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /maps/{mapId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /resourcePaths/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pendingResourcePaths/{resourceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mapSubmissions/{submissionId} {
      allow read: if isAdmin() || (signedIn()
        && resource.data.submittedBy == request.auth.uid);

      // User submissions are validated and version-reserved atomically by the
      // createMapSubmission Cloud Function. Admin SDK writes bypass rules;
      // browser clients cannot skip the authoritative duplicate-version check.
      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        && request.resource.data.recipientUid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /catalogSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
