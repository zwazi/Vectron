rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /accounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'requestedAuthorName', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.requestedAuthorName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);

      allow update, delete: if isAdmin();
    }

    match /authors/{authorId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /maps/{mapId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /resourcePaths/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pendingResourcePaths/{resourceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Trusted duplicate/rate-limit reservations. Browser clients never need
    // to enumerate or mutate these anti-abuse records.
    match /pendingSubmissionHashes/{reservationId} {
      allow read, write: if false;
    }

    match /pendingClientMaps/{reservationId} {
      allow read, write: if false;
    }

    match /submissionRateLimits/{uid} {
      allow read, write: if false;
    }

    // Storage Rules can inspect these short-lived grants, but browser clients
    // cannot mint, inspect, or extend them directly.
    match /submissionUploadGrants/{submissionId} {
      allow read, write: if false;
    }

    match /mapSubmissions/{submissionId} {
      allow read: if isAdmin() || (signedIn()
        && resource.data.submittedBy == request.auth.uid);

      // User submissions are validated and version-reserved atomically by the
      // createMapSubmission Cloud Function. Admin SDK writes bypass rules;
      // browser clients cannot skip the authoritative duplicate-version check.
      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        && request.resource.data.recipientUid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if isAdmin();
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /catalogSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Small invalidation/status documents replace repeated full catalog scans.
    // Only trusted server code writes either collection.
    match /catalogState/{stateId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /serverCatalogState/{serverId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Canonical Neotron UID -> legacy Vectron repository UID. Only trusted
    // bridge code may read or write these private migration records.
    match /accountLinks/{neotronUid} {
      allow read, write: if false;
    }

    // Precomputed, bounded leaderboard snapshots. Exact document reads are
    // public; collection scans are intentionally impossible from browsers.
    match /racingLeaderboards/{mapDocumentId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /racingOverall/{documentId} {
      allow get: if documentId == 'current';
      allow list, create, update, delete: if false;
    }

    match /racingCatalog/{documentId} {
      allow get: if documentId == 'current';
      allow list, create, update, delete: if false;
    }

    match /racingProfiles/{playerId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /racingRunHistories/{historyId} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
  }
}
