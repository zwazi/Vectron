rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function account(uid) {
      return firestore.get(/databases/(default)/documents/accounts/$(uid));
    }

    function submission(submissionId) {
      return firestore.get(
        /databases/(default)/documents/mapSubmissions/$(submissionId)
      );
    }

    function uploadGrant(submissionId) {
      return firestore.get(
        /databases/(default)/documents/submissionUploadGrants/$(submissionId)
      );
    }

    function hasApprovedAccount() {
      return signedIn()
        && account(request.auth.uid).data.status == 'approved'
        && account(request.auth.uid).data.authorId is string;
    }

    function validRevisionUpload(ownerUid, submissionId, expectedPath) {
      return resource == null
        && signedIn()
        && request.auth.uid == ownerUid
        && (isAdmin() || (
          hasApprovedAccount()
          && firestore.exists(
            /databases/(default)/documents/submissionUploadGrants/$(submissionId)
          )
          && uploadGrant(submissionId).data.ownerUid == ownerUid
          && uploadGrant(submissionId).data.submissionId == submissionId
          && uploadGrant(submissionId).data.storagePath == expectedPath
          && uploadGrant(submissionId).data.expiresAt > request.time
          && uploadGrant(submissionId).data.contentBytes == request.resource.size
          && uploadGrant(submissionId).data.authorId == request.resource.metadata.authorId
          && uploadGrant(submissionId).data.authorName == request.resource.metadata.authorName
          && uploadGrant(submissionId).data.category == request.resource.metadata.category
          && uploadGrant(submissionId).data.mapName == request.resource.metadata.mapName
          && uploadGrant(submissionId).data.mapVersion == request.resource.metadata.mapVersion
          && uploadGrant(submissionId).data.operation == request.resource.metadata.operation
          && uploadGrant(submissionId).data.sha256 == request.resource.metadata.sha256
        ))
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('application/xml.*')
        && request.resource.metadata.ownerUid == ownerUid
        && request.resource.metadata.submissionId == submissionId
        && request.resource.metadata.authorId is string
        && request.resource.metadata.authorName is string
        && (request.resource.metadata.category == 'maps'
          || (isAdmin()
            && request.resource.metadata.category is string
            && request.resource.metadata.category.size() > 0
            && request.resource.metadata.category.size() <= 60
            && !request.resource.metadata.category.matches('.*[/].*')))
        && request.resource.metadata.mapName is string
        && request.resource.metadata.mapVersion is string
        && request.resource.metadata.mapName.size() > 0
        && request.resource.metadata.mapVersion.size() > 0
        && request.resource.metadata.operation is string
        && request.resource.metadata.sha256.matches('[0-9a-f]{64}')
        && (isAdmin()
          || request.resource.metadata.authorId == account(ownerUid).data.authorId);
    }

    function canReadRevision(ownerUid, submissionId, expectedPath) {
      return isAdmin()
        || (signedIn() && request.auth.uid == ownerUid)
        || (firestore.exists(
            /databases/(default)/documents/mapSubmissions/$(submissionId)
          )
          && submission(submissionId).data.storagePath == expectedPath);
    }

    match /_catalog/public/{fileName} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Game servers download this with their service-account credentials.
    match /_catalog/server/{fileName} {
      allow read, write: if false;
    }

    // Immutable, compact recordings and deduplicated settings snapshots.
    // Their Firestore indexes are exact-read only, so clients cannot list the
    // bucket or enumerate player histories.
    match /_racing/{kind}/{serverId}/{fileName} {
      allow get: if kind == 'replays' || kind == 'settings';
      allow list, create, update, delete: if false;
    }

    // Retain read support for immutable revisions uploaded before filenames
    // became part of the storage path.
    match /_revisions/{ownerUid}/{submissionId} {
      allow get: if canReadRevision(
        ownerUid,
        submissionId,
        '_revisions/' + ownerUid + '/' + submissionId
      );
      allow create: if validRevisionUpload(
        ownerUid,
        submissionId,
        '_revisions/' + ownerUid + '/' + submissionId
      );
      allow update: if false;
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    match /_revisions/{ownerUid}/{submissionId}/{fileName} {
      allow get: if canReadRevision(
        ownerUid,
        submissionId,
        '_revisions/' + ownerUid + '/' + submissionId + '/' + fileName
      );
      allow create: if fileName.matches('.*\\.aamap\\.xml')
        && validRevisionUpload(
          ownerUid,
          submissionId,
          '_revisions/' + ownerUid + '/' + submissionId + '/' + fileName
        );
      allow update: if false;
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    // Existing objects remain public while the one-time migration records them
    // in Firestore. They are read-only; new revisions use /_revisions/.
    match /{author}/{category}/{fileName} {
      allow get: if author != '_revisions' && author != '_catalog'
        && fileName.matches('.*\\.aamap\\.xml');
      allow create, update, delete, list: if false;
    }

    match /{author}/{category}/archive/{fileName} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
